{% extends 'layout.twig' %}

{% block content %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-user-edit me-3"></i>Izmeni korisnika</h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">
                {% if error %}
                    <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>{{ error }}</div>
                {% endif %}

                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-user me-1"></i>Korisničko ime:</label>
                        <input type="text" name="username" class="form-control" value="{{ user.username }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-envelope me-1"></i>Email:</label>
                        <input type="email" name="email" class="form-control" value="{{ user.email }}">
                    </div>
                    <div class="mb-4">
                        <label class="form-label"><i class="fas fa-tag me-1"></i>Rola:</label>
                        <select name="role" class="form-select">
                            <option value="user" {% if user.role == 'user' %}selected{% endif %}>User</option>
                            <option value="manager" {% if user.role == 'manager' %}selected{% endif %}>Manager</option>
                            <option value="admin" {% if user.role == 'admin' %}selected{% endif %}>Admin</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Sačuvaj
                        </button>
                        <a href="{{ base_url }}users" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Otkaži
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}