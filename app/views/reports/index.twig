{% extends 'layout.twig' %}

{% block content %}
<h1 class="mb-4">Izveštaji</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Narudžbine</h5>
            </div>
            <div class="card-body">
                <p>Ukupno narudžbina: <strong>{{ orders|length }}</strong></p>
                <a href="{{ base_url }}report/excel?type=orders" class="btn btn-success mb-2 w-100">Export Excel</a>
                <a href="{{ base_url }}report/pdf?type=orders" class="btn btn-danger w-100">Export PDF</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Proizvodi</h5>
            </div>
            <div class="card-body">
                <p>Ukupno proizvoda: <strong>{{ products|length }}</strong></p>
                <a href="{{ base_url }}report/excel?type=products" class="btn btn-success mb-2 w-100">Export Excel</a>
                <a href="{{ base_url }}report/pdf?type=products" class="btn btn-danger w-100">Export PDF</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Korisnici</h5>
            </div>
            <div class="card-body">
                <p>Ukupno korisnika: <strong>{{ users|length }}</strong></p>
                <a href="{{ base_url }}report/excel?type=users" class="btn btn-success mb-2 w-100">Export Excel</a>
                <a href="{{ base_url }}report/pdf?type=users" class="btn btn-danger w-100">Export PDF</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}