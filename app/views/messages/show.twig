{% extends 'layout.twig' %}

{% block content %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-envelope me-3"></i>{{ message.subject }}</h1>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mb-4 p-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-envelope me-2"></i>Poruka</h5>
                {% if session.role == 'admin' or session.role == 'manager' %}
                    <p><i class="fas fa-user me-2 text-muted"></i><strong>Korisnik:</strong> {{ message.username }} ({{ message.email }})</p>
                {% endif %}
                <p><i class="fas fa-calendar me-2 text-muted"></i><strong>Datum:</strong> {{ message.created_at }}</p>
                <hr>
                <p>{{ message.message }}</p>
            </div>

            {% if message.response %}
                <div class="card mb-4 p-4 border-success">
                    <h5 class="fw-bold mb-3 text-success"><i class="fas fa-reply me-2"></i>Odgovor</h5>
                    <p>{{ message.response }}</p>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-clock me-2"></i>Još uvek nema odgovora.
                </div>
            {% endif %}

            <a href="{{ base_url }}messages" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Nazad
            </a>
        </div>
    </div>
</div>
{% endblock %}