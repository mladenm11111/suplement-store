{% extends 'layout.twig' %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="mb-4">Odgovori na poruku</h1>

        <div class="card mb-4">
            <div class="card-body">
                <p><strong>Korisnik:</strong> {{ message.username }}</p>
                <p><strong>Naslov:</strong> {{ message.subject }}</p>
                <p><strong>Poruka:</strong></p>
                <p>{{ message.message }}</p>
            </div>
        </div>

        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <form method="POST">
            <div class="mb-3">
                <label class="form-label">Odgovor:</label>
                <textarea name="response" class="form-control" rows="5"></textarea>
            </div>
            <button type="submit" class="btn btn-warning">Pošalji odgovor</button>
            <a href="{{ base_url }}messages" class="btn btn-secondary ms-2">Otkaži</a>
        </form>
    </div>
</div>
{% endblock %}