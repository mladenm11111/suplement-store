{% extends 'layout.twig' %}

{% block content %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-envelope me-3"></i>Poruke</h1>
    </div>
</div>

<div class="container">
    {% if session.role == 'user' %}
        <a href="{{ base_url }}message/send" class="btn btn-success mb-4">
            <i class="fas fa-paper-plane me-2"></i>Pošalji poruku
        </a>
    {% endif %}

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    {% if session.role == 'admin' or session.role == 'manager' %}
                        <th>Korisnik</th>
                    {% endif %}
                    <th>Naslov</th>
                    <th>Datum</th>
                    <th>Status</th>
                    <th>Akcije</th>
                </tr>
            </thead>
            <tbody>
                {% for message in messages %}
                <tr>
                    <td><strong>#{{ message.id }}</strong></td>
                    {% if session.role == 'admin' or session.role == 'manager' %}
                        <td><i class="fas fa-user me-1"></i>{{ message.username }}</td>
                    {% endif %}
                    <td>{{ message.subject }}</td>
                    <td><i class="fas fa-calendar me-1"></i>{{ message.created_at }}</td>
                    <td>
                        {% if message.response %}
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Odgovoreno</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Na čekanju</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a href="{{ base_url }}message/id/{{ message.id }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-eye me-1"></i>Detalji
                            </a>
                            {% if session.role == 'admin' or session.role == 'manager' %}
                                <a href="{{ base_url }}message/reply/{{ message.id }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-reply me-1"></i>Odgovori
                                </a>
                                <form method="POST" action="{{ base_url }}message/delete/{{ message.id }}" onsubmit="return confirm('Da li ste sigurni?')">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="fas fa-envelope-open" style="font-size: 3rem; color: #ddd;"></i>
                            <p class="mt-2 text-muted">Nema poruka.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}