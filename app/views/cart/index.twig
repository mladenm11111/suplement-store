{% extends 'layout.twig' %}

{% block content %}
<h1 class="mb-4">Korpa</h1>

{% if products %}
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Proizvod</th>
            <th>Cena</th>
            <th>Količina</th>
            <th>Ukupno</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        {% for product in products %}
        <tr>
            <td>{{ product.name }}</td>
            <td>{{ product.price }} RSD</td>
            <td>{{ product.quantity }}</td>
            <td>{{ product.subtotal }} RSD</td>
            <td>
                <form method="POST" action="{{ base_url }}cart/remove/{{ product.id }}">
                    <button type="submit" class="btn btn-danger btn-sm">Ukloni</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3"><strong>Ukupno:</strong></td>
            <td><strong>{{ total }} RSD</strong></td>
            <td></td>
        </tr>
    </tfoot>
</table>

<form method="POST" action="{{ base_url }}cart/checkout" onsubmit="return confirm('Da li ste sigurni da želite da poručite?')">
    <button type="submit" class="btn btn-success">Poruči</button>
</form>
{% else %}
    <p>Vaša korpa je prazna.</p>
    <a href="{{ base_url }}products" class="btn btn-primary">Pogledaj proizvode</a>
{% endif %}
{% endblock %}