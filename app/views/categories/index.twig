{% extends 'layout.twig' %}

{% block content %}
<h1 class="mb-4">Kategorije</h1>

<a href="{{ base_url }}category/add" class="btn btn-success mb-3">Dodaj kategoriju</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Naziv</th>
            <th>Opis</th>
            <th colspan="2" class="text-center">Akcije</th>
        </tr>
    </thead>
    <tbody>
        {% for category in categories %}
        <tr>
            <td>{{ category.id }}</td>
            <td>{{ category.name }}</td>
            <td>{{ category.description }}</td>
            <td>
                <a href="{{ base_url }}category/update/{{ category.id }}" class="btn btn-warning btn-sm">Izmeni</a>
            </td>
            <td>
                <form method="POST" action="{{ base_url }}category/delete/{{ category.id }}" onsubmit="return confirm('Da li ste sigurni?')">
                    <button type="submit" class="btn btn-danger btn-sm">Obriši</button>
                </form>
            </td>
        </tr>
        {% else %}
            <tr><td colspan="5">Nema kategorija.</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}