{% extends 'layout.twig' %}

{% block content %}

{% if not session.user_id %}
<div class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1>Dostignite svoje <span>fitness ciljeve</span></h1>
                <p class="mt-3">Pronađite kvalitetne suplemente za izgradnju mišića, mršavljenje i poboljšanje performansi.</p>
                <a href="{{ base_url }}auth/register" class="btn btn-primary btn-lg mt-3 me-2">
                    <i class="fas fa-user-plus me-2"></i>Registruj se
                </a>
                <a href="{{ base_url }}auth/login" class="btn btn-outline-light btn-lg mt-3">
                    <i class="fas fa-sign-in-alt me-2"></i>Prijavi se
                </a>
            </div>
            <div class="col-md-5 text-center d-none d-md-block">
                <i class="fas fa-dumbbell" style="font-size: 10rem; color: rgba(255,107,0,0.3);"></i>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-box me-3"></i>Proizvodi</h1>
    </div>
</div>
{% endif %}

<div class="container">
    <div class="card mb-4 p-3">
        <form method="GET" action="{{ base_url }}products">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label"><i class="fas fa-search me-1"></i>Pretraga</label>
                    <input type="text" name="search" class="form-control" placeholder="Pretraži proizvode..." value="{{ keyword }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-tags me-1"></i>Kategorija</label>
                    <select name="category_id" class="form-select">
                        <option value="">Sve kategorije</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if category_id == category.id %}selected{% endif %}>
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="fas fa-award me-1"></i>Brend</label>
                    <select name="brand_id" class="form-select">
                        <option value="">Svi brendovi</option>
                        {% for brand in brands %}
                            <option value="{{ brand.id }}" {% if brand_id == brand.id %}selected{% endif %}>
                                {{ brand.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Pretraži
                    </button>
                </div>
            </div>
        </form>
    </div>

    {% if session.role == 'admin' %}
        <a href="{{ base_url }}product/add" class="btn btn-success mb-4">
            <i class="fas fa-plus me-2"></i>Dodaj proizvod
        </a>
    {% endif %}

    <div class="row">
        {% for product in products %}
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                {% if product.image %}
                    <img src="{{ base_url }}uploads/{{ product.image }}" class="card-img-top">
                {% else %}
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
                        <i class="fas fa-box" style="font-size: 5rem; color: #ddd;"></i>
                    </div>
                {% endif %}
                <div class="card-body">
                    <span class="badge bg-warning text-dark mb-2">{{ product.category_name }}</span>
                    <span class="badge bg-secondary mb-2">{{ product.brand_name }}</span>
                    <h5 class="card-title mt-1">{{ product.name }}</h5>
                    <p class="card-text text-muted">{{ product.description|slice(0, 80) }}...</p>
                    <p class="price-tag">{{ product.price }} RSD</p>
                    <p class="text-muted small"><i class="fas fa-cubes me-1"></i>Na stanju: {{ product.stock }}</p>
                </div>
                <div class="card-footer d-flex gap-2 flex-wrap">
                    <a href="{{ base_url }}product/id/{{ product.id }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-eye me-1"></i>Detalji
                    </a>
                    {% if session.role == 'admin' %}
                        <a href="{{ base_url }}product/update/{{ product.id }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit me-1"></i>Izmeni
                        </a>
                        <form method="POST" action="{{ base_url }}product/delete/{{ product.id }}" onsubmit="return confirm('Da li ste sigurni?')">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Obriši
                            </button>
                        </form>
                    {% endif %}
                    {% if session.role == 'user' %}
                        <a href="{{ base_url }}cart/add/{{ product.id }}" class="btn btn-success btn-sm">
                            <i class="fas fa-cart-plus me-1"></i>Dodaj u korpu
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="fas fa-box-open" style="font-size: 5rem; color: #ddd;"></i>
                <p class="mt-3 text-muted">Nema pronađenih proizvoda.</p>
            </div>
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            {% for i in 1..totalPages %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="{{ base_url }}products?search={{ keyword }}&category_id={{ category_id }}&brand_id={{ brand_id }}&page={{ i }}">{{ i }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
    {% endif %}
</div>
{% endblock %}