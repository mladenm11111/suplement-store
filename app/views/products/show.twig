{% extends 'layout.twig' %}

{% block content %}
<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-box me-3"></i>{{ product.name }}</h1>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="row g-0">
            <div class="col-md-5">
                {% if product.image %}
                    <img src="{{ base_url }}uploads/{{ product.image }}" class="img-fluid rounded-start" style="height: 100%; object-fit: cover;">
                {% else %}
                    <div class="d-flex align-items-center justify-content-center bg-light h-100" style="min-height: 300px;">
                        <i class="fas fa-box" style="font-size: 8rem; color: #ddd;"></i>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="badge bg-warning text-dark me-2">{{ product.category_name }}</span>
                        <span class="badge bg-secondary">{{ product.brand_name }}</span>
                    </div>
                    <h2 class="card-title">{{ product.name }}</h2>
                    <p class="card-text text-muted">{{ product.description }}</p>
                    <hr>
                    <p class="price-tag mb-2">{{ product.price }} RSD</p>
                    <p class="text-muted"><i class="fas fa-cubes me-2"></i>Na stanju: {{ product.stock }}</p>
                    <div class="d-flex gap-2 mt-4">
                        {% if session.role == 'user' %}
                            <a href="{{ base_url }}cart/add/{{ product.id }}" class="btn btn-success">
                                <i class="fas fa-cart-plus me-2"></i>Dodaj u korpu
                            </a>
                        {% endif %}
                        {% if session.role == 'admin' %}
                            <a href="{{ base_url }}product/update/{{ product.id }}" class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Izmeni
                            </a>
                        {% endif %}
                        <a href="{{ base_url }}products" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Nazad
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}