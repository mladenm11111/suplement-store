<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ base_url }}">Suplement Store</a>
            <div class="navbar-nav ms-auto">
                {% if session.user_id %}
                    {% if session.role == 'admin' %}
                        <a class="nav-link" href="{{ base_url }}products">Proizvodi</a>
                        <a class="nav-link" href="{{ base_url }}categories">Kategorije</a>
                        <a class="nav-link" href="{{ base_url }}brands">Brendovi</a>
                        <a class="nav-link" href="{{ base_url }}users">Korisnici</a>
                        <a class="nav-link" href="{{ base_url }}orders">Narudžbine</a>
                        <a class="nav-link" href="{{ base_url }}reports">Izveštaji</a>
                    {% elseif session.role == 'manager' %}
                        <a class="nav-link" href="{{ base_url }}products">Proizvodi</a>
                        <a class="nav-link" href="{{ base_url }}orders">Narudžbine</a>
                        <a class="nav-link" href="{{ base_url }}users">Korisnici</a>
                        <a class="nav-link" href="{{ base_url }}messages">Poruke</a>
                    {% else %}
                        <a class="nav-link" href="{{ base_url }}products">Proizvodi</a>
                        <a class="nav-link" href="{{ base_url }}cart">Korpa</a>
                        <a class="nav-link" href="{{ base_url }}orders">Moje narudžbine</a>
                        <a class="nav-link" href="{{ base_url }}messages">Poruke</a>
                    {% endif %}
                    <a class="nav-link" href="{{ base_url }}auth/logout">Odjava</a>
                {% else %}
                    <a class="nav-link" href="{{ base_url }}products">Proizvodi</a>
                    <a class="nav-link" href="{{ base_url }}auth/login">Prijava</a>
                    <a class="nav-link" href="{{ base_url }}auth/register">Registracija</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {% block content %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>